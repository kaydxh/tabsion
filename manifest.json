{
  "manifest_version": 3,
  "name": "TabSilo",
  "version": "1.0.0",
  "description": "Save tabs to a global pool, auto-group by domain, deduplicate.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "TabSilo - Save all tabs"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
